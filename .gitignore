node_modules/
dist/
build/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.env
.env.local

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Go build artifacts. `go build ./...` in a main package drops a binary named
# after the module directory — 23MB of it, right next to the source.
/examples/go-service/go-service-example
/examples/go-echo-service/go-echo-service-example
*.test
*.out

# Local credential files — never commit (this repo is public)
npmjs_token.txt
*token*.txt
.npmrc.local

# Compiled binaries. `go build ./...` drops an executable named after the
# directory into it — .exe on Windows — and a `git add -A` will happily commit
# 140 MB of them. This repo is cloned by every client that installs the
# onboarding plugin, so build artifacts here are not merely untidy.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Transient dir created by the ESM-hook integration test (inside the package
# because ESM resolution needs node_modules above it, not the OS temp dir).
packages/observability/.esm-hook-test-*/
