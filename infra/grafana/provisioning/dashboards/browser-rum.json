      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(browser_web_vital_lcp_milliseconds_bucket{service_name=~\"$service\"}[5m])))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{route}}"
        }
      ]
    },
