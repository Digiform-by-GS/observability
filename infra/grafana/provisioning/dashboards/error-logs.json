    {
      "type": "logs",
      "title": "Error lines - expand one for its trace_id",
      "description": "Expand a line for its structured metadata: trace_id, span_id, http_route, duration_ms. trace_id carries links to Tempo and to Blast Radius.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 13,
        "w": 16,
        "x": 8,
        "y": 9
      },
