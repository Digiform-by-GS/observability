          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\", deployment_environment=~\"$environment\"} | team=~\"$team\" | severity_text=~\"ERROR|FATAL|CRITICAL\" or http_response_status_code>=$min_status [$__interval]))",
