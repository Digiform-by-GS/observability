        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", team=~\"$team\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{http_route}}"
        }
      ]
    },
