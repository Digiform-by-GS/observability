# Template for the shared platform deployment's .env file.
#
#   cp .env.platform.example .env     # on the platform host, then edit
#
# .env is already gitignored (.gitignore:11). Never commit the real file — this
# repository is public.

# Stamped onto every signal as deployment.environment by the collector's
# `resource` processor, using `insert` so an app that sets its own value wins.
DEPLOYMENT_ENVIRONMENT=shared-dev

# Grafana admin login. Compose refuses to start if GRAFANA_ADMIN_PASSWORD is
# unset, so there is no way to accidentally deploy a default password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Anonymous read-only access to dashboards. `true` keeps the zero-friction
# experience — developers open Grafana and see their service without an account,
# but cannot edit datasources or dashboards. Set to `false` to require a login
# for viewing as well.
GRAFANA_ANONYMOUS=true

# Discord webhook that alert notifications are posted to. Treat as a
# credential: anyone with the URL can post to the channel. Referenced by
# provisioning/alerting/contact-points.yaml as $__env{DISCORD_WEBHOOK_URL};
# leave it unset and alerts still fire, they just notify nowhere.
DISCORD_WEBHOOK_URL=
