{
  "name": "@digiform/nodejs-sample",
  "version": "0.1.0",
  "private": true,
  "description": "Express demo wired to @digiform/observability — emits trace-correlated logs, traces, and metrics to the local OTel Collector.",
  "type": "module",
  "scripts": {
    "start": "node --import tsx --import @digiform/observability/preload src/index.ts",
    "dev": "tsx watch --import @digiform/observability/preload src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@digiform/observability": "*",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
