{
  "name": "@digiform-by-gs/platform-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Platform front door - service catalogue with signal coverage, and Grafana panels embedded per service.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/public','dist/public',{recursive:true})\" && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
