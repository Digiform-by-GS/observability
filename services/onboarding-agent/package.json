{
  "name": "@digiform-by-gs/onboarding-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted onboarding agent — clients submit a repository, an agent instruments it and returns a patch or opens a PR.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20.6.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
